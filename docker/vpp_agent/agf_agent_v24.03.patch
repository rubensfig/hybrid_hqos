+					SwIfIndex: 0,
+					QueueID:   1,
+					WorkerID:  1, // worker 0
+					Mode:      2, // interrupt
+				},
+				&vpp_interfaces.SwInterfaceRxPlacementDetails{
+					SwIfIndex: 0,
+					QueueID:   2,
+					WorkerID:  2, // worker 1
+					Mode:      1, // polling
+				},
+			},
+		},
+		{
+			Name: (&vpp_ip.IPUnnumberedDump{}).GetMessageName(),
+			Ping: true,
