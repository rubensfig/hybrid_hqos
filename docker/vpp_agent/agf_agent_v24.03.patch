+// (**) generate adapters for firewall descriptors
+// descriptors
+//go:generate descriptor-adapter --descriptor-name BlocklistInterface --value-type *vpp_firewall.BlocklistInterface --import "_/agf-dp-mgmt-plugins/proto/firewall" --output-dir "descriptor"
+//go:generate descriptor-adapter --descriptor-name BlocklistIpv45Tuple --value-type *vpp_firewall.BlocklistRuleIpv45Tuple --import "_/agf-dp-mgmt-plugins/proto/firewall" --output-dir "descriptor"
+//go:generate descriptor-adapter --descriptor-name AllowlistInterface --value-type *vpp_firewall.AllowlistInterface --import "_/agf-dp-mgmt-plugins/proto/firewall" --output-dir "descriptor"
+//go:generate descriptor-adapter --descriptor-name AllowlistIpv45Tuple --value-type *vpp_firewall.AllowlistRuleIpv45Tuple --import "_/agf-dp-mgmt-plugins/proto/firewall" --output-dir "descriptor"
+
+package firewallplugin
+
+import (
+	"github.com/pkg/errors"
+	"go.ligato.io/cn-infra/v2/infra"
+
+	"_/agf-dp-mgmt-plugins/firewallplugin/descriptor"
+	"_/agf-dp-mgmt-plugins/firewallplugin/descriptor/adapter"
+	"_/agf-dp-mgmt-plugins/firewallplugin/vppcalls"
+
+	"go.ligato.io/cn-infra/v2/health/statuscheck"
+	"go.ligato.io/vpp-agent/v3/plugins/govppmux"
+	kvs "go.ligato.io/vpp-agent/v3/plugins/kvscheduler/api"
+	"go.ligato.io/vpp-agent/v3/plugins/vpp/ifplugin"
+
+	// Register vppcalls implementation for VPP 24.02
+	_ "_/agf-dp-mgmt-plugins/firewallplugin/vppcalls/vpp2402"
+)
+
+// Deps lists dependencies of the Firewall plugin.
+type Deps struct {
+	infra.PluginDeps
+	KVScheduler kvs.KVScheduler
+	IfPlugin    ifplugin.API
+	VPP         govppmux.API
+	StatusCheck statuscheck.PluginStatusWriter
+}
+
+// FirewallPlugin  is a plugin that configures VPP Firewall blocklist and allowlist using GoVPP
+type FirewallPlugin struct {
+	Deps
+
+	// handlers
+	firewallHandler vppcalls.FirewallVppAPI
+
+	// descriptors
+	blocklistIfaceDescriptor      *descriptor.BlocklistInterfaceDescriptor
+	blocklistIpv45TupleDescriptor *descriptor.BlocklistIpv45TupleDescriptor
+	allowlistIfaceDescriptor      *descriptor.AllowlistInterfaceDescriptor
+	allowlistIpv45TupleDescriptor *descriptor.AllowlistIpv45TupleDescriptor
+}
+
+// Init method registers descriptors for all objects the plugin implements
+func (p *FirewallPlugin) Init() (err error) {
+	if !p.VPP.IsPluginLoaded("firewall") {
+		p.Log.Warnf("VPP plugin Firewall was disabled by VPP")
+		return nil
+	}
+
+	// Get compatible VPP calls handler (relevant to VPP version)
+	p.firewallHandler = vppcalls.CompatibleFirewallVppHandler(p.VPP, p.IfPlugin.GetInterfaceIndex(), p.Log)
+	if p.firewallHandler == nil {
+		return errors.New("Firewall VPP Handler is not available")
+	}
+
+	// init & register firewall descriptors
+	p.blocklistIfaceDescriptor = descriptor.NewBlocklistInterfaceDescriptor(p.firewallHandler, p.Log)
+	blocklistIfaceDescriptor := adapter.NewBlocklistInterfaceDescriptor(p.blocklistIfaceDescriptor.GetDescriptor())
+	err = p.KVScheduler.RegisterKVDescriptor(blocklistIfaceDescriptor)
+	if err != nil {
+		return err
+	}
+
+	p.blocklistIpv45TupleDescriptor = descriptor.NewBlocklistIpv45TupleDescriptor(p.firewallHandler, p.Log)
+	blocklistIpv45TupleDescriptor := adapter.NewBlocklistIpv45TupleDescriptor(p.blocklistIpv45TupleDescriptor.GetDescriptor())
+	err = p.KVScheduler.RegisterKVDescriptor(blocklistIpv45TupleDescriptor)
+	if err != nil {
+		return err
+	}
+
+	p.allowlistIfaceDescriptor = descriptor.NewAllowlistInterfaceDescriptor(p.firewallHandler, p.Log)
+	allowlistIfaceDescriptor := adapter.NewAllowlistInterfaceDescriptor(p.allowlistIfaceDescriptor.GetDescriptor())
+	err = p.KVScheduler.RegisterKVDescriptor(allowlistIfaceDescriptor)
+	if err != nil {
+		return err
+	}
+
+	p.allowlistIpv45TupleDescriptor = descriptor.NewAllowlistIpv45TupleDescriptor(p.firewallHandler, p.Log)
+	allowlistIpv45TupleDescriptor := adapter.NewAllowlistIpv45TupleDescriptor(p.allowlistIpv45TupleDescriptor.GetDescriptor())
+	err = p.KVScheduler.RegisterKVDescriptor(allowlistIpv45TupleDescriptor)
+	if err != nil {
+		return err
+	}
+
+	return nil
+}
+
+// AfterInit registers plugin with StatusCheck.
+func (p *FirewallPlugin) AfterInit() error {
+	if p.StatusCheck != nil {
+		p.StatusCheck.Register(p.PluginName, nil)
+	}
+	return nil
+}
