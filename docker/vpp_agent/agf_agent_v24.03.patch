+	"go.ligato.io/vpp-agent/v3/plugins/vpp/ifplugin/ifaceidx"
+)
+
+// FlowtableVppAPI groups Flowtable Vpp APIs.
+type FlowtableVppAPI interface {
+	FlowtableQinqIntfVppAPI
+	FlowtableQinqEntryVppAPI
+
+	FlowtableIP4IntfVppAPI
+	FlowtableIP4EntryVppAPI
+}
+
+var handler = vpp.RegisterHandler(vpp.HandlerDesc{
+	Name:       "vpp_flowtable",
+	HandlerAPI: (*FlowtableVppAPI)(nil),
+})
+
+// FlowtableQinqIntfVppAPI provides methods for managing enable/disable of Flowtable Qinq
+type FlowtableQinqIntfVppAPI interface {
+	EnableFlowtableQinqIntf(flowtableqinqintf *flw.FlowtableQinqIntf) error
+	DisableFlowtableQinqIntf(flowtableQinqIntf *flw.FlowtableQinqIntf) error
+}
+
+// FlowtableIP4IntfVppAPI provides methods for managing Flowtable IP4 enable/disable
+type FlowtableIP4IntfVppAPI interface {
+	EnableFlowtableIP4Intf(flowtableip4intf *flw.FlowtableIP4Intf) error
+	DisableFlowtableIP4Intf(flowtableIP4Intf *flw.FlowtableIP4Intf) error
+}
+
+// FlowtableQinqEntryVppAPI provides methods for managing Flowtable Qinq entries.
+type FlowtableQinqEntryVppAPI interface {
+	AddFlowtableQinqEntry(flowtableQinqEntry *flw.FlowtableQinqEntry) error
+	DeleteFlowtableQinqEntry(flowtableQinqEntry *flw.FlowtableQinqEntry) error
+}
+
+// FlowtableIP4EntryVppAPI provides methods for managing Flowtable IP4 entries.
+type FlowtableIP4EntryVppAPI interface {
+	AddFlowtableIP4Entry(flowtableIP4Entry *flw.FlowtableIP4Entry) error
+	DeleteFlowtableIP4Entry(flowtableIP4Entry *flw.FlowtableIP4Entry) error
+}
+
+// AddFlowtableHandlerVersion is used to register implementations of VPP handler API
+// interface for a specific VPP version.
+func AddFlowtableHandlerVersion(version vpp.Version, msgs []govppapi.Message,
+	h func(ch govppapi.Channel, ifIdx ifaceidx.IfaceMetadataIndex, log logging.Logger) FlowtableVppAPI,
+) {
+	handler.AddVersion(vpp.HandlerVersion{
+		Version: version,
+		Check: func(c vpp.Client) error {
+			ch, err := c.NewAPIChannel()
+			if err != nil {
+				return err
+			}
+			return ch.CheckCompatiblity(msgs...)
+		},
+		NewHandler: func(c vpp.Client, a ...interface{}) vpp.HandlerAPI {
+			ch, err := c.NewAPIChannel()
+			if err != nil {
+				return err
+			}
+			return h(ch, a[0].(ifaceidx.IfaceMetadataIndex), a[1].(logging.Logger))
+		},
+	})
+}
+
+// CompatibleFlowtableVppHandler checks all the registered implementations to find the
+// compatible handler implementation.
+func CompatibleFlowtableVppHandler(c vpp.Client, ifIdx ifaceidx.IfaceMetadataIndex, log logging.Logger) FlowtableVppAPI {
+	if v := handler.FindCompatibleVersion(c); v != nil {
+		return v.NewHandler(c, ifIdx, log).(FlowtableVppAPI)
+	}
+	return nil
+}
