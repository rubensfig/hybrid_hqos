+		return kvs.NewInvalidValueError(ErrAlwDstIPNotDefined, "dst-ip")
+	}
+	return nil
+}
+
+// Create uses vppcalls to pass Allowlist configuration to VPP.
+func (f *AllowlistIpv45TupleDescriptor) Create(key string, allowlistIpv45Tuple *frwl.AllowlistRuleIpv45Tuple) (metadata interface{}, err error) {
+	//Add Allowlist entry
+	err = f.allowlistIPv45TupleHandler.AddAllowlistRuleIpv45Tuple(allowlistIpv45Tuple)
+	if err != nil {
+		f.log.Error(err)
+	}
+	return nil, err
+
+}
+
+// Delete removes VPP Allowlist IPv4-5Tuple configuration.
+func (f *AllowlistIpv45TupleDescriptor) Delete(key string, allowlistIpv45Tuple *frwl.AllowlistRuleIpv45Tuple, metadata interface{}) error {
+	err := f.allowlistIPv45TupleHandler.DeleteAllowlistRuleIpv45Tuple(allowlistIpv45Tuple)
+	if err != nil {
+		f.log.Error(err)
+	}
+	return err
+}
