+	"google.golang.org/protobuf/proto"
+	"go.ligato.io/cn-infra/v2/logging"
+
+	"_/agf-dp-mgmt-plugins/bngpolicerplugin/descriptor/adapter"
+	"_/agf-dp-mgmt-plugins/bngpolicerplugin/vppcalls"
+	bngp "_/agf-dp-mgmt-plugins/proto/bngpolicer"
+
+	kvs "go.ligato.io/vpp-agent/v3/plugins/kvscheduler/api"
+)
+
+const (
+	// BngpolicerEntryDescriptorName is the name of the descriptor for vpp bngpolicer  entry.
+	BngpolicerEntryDescriptorName = "vpp-bngpolicer-entry"
+)
+
+// Validation errors:
+var (
+	// ErrNameNotDefined returned when policer name in confiugration is empty string.
+	ErrNameNotDefined = errors.New("invalid name for bng policer entry")
+)
+
+// BngpolicerIntfDescriptor teaches KVScheduler how to configure VPP Bngpolicer entries.
+type BngpolicerEntryDescriptor struct {
+	log                    logging.Logger
+	bngpolicerEntryHandler vppcalls.BngpolicerEntryVppAPI
+}
+
+// NewBngpolicerEntryDescriptor
+func NewBngpolicerEntryDescriptor(bngpolicerEntryHandler vppcalls.BngpolicerEntryVppAPI, log logging.PluginLogger) *BngpolicerEntryDescriptor {
+	return &BngpolicerEntryDescriptor{
+		bngpolicerEntryHandler: bngpolicerEntryHandler,
+		log:                    log.NewLogger("bngpolicer-entry-descriptor"),
+	}
+}
+
+// GetDescriptor returns descriptor suitable for registration (via adapter) with the KVScheduler.
+func (f *BngpolicerEntryDescriptor) GetDescriptor() *adapter.BngPolicerEntryDescriptor {
+	return &adapter.BngPolicerEntryDescriptor{
+		Name:            BngpolicerEntryDescriptorName,
+		NBKeyPrefix:     bngp.ModelBngPolicerEntry.KeyPrefix(),
+		ValueTypeName:   bngp.ModelBngPolicerEntry.ProtoName(),
+		KeySelector:     bngp.ModelBngPolicerEntry.IsKeyValid,
+		KeyLabel:        bngp.ModelBngPolicerEntry.StripKeyPrefix,
+		ValueComparator: f.EquivalentBngpolicerEntry,
+		Validate:        f.Validate,
+		Create:          f.Create,
+		Delete:          f.Delete,
+	}
+
+}
+
+// EquivalentBngpolicerEntry is case-insensitive comparison function for bngpolicer  Entry.
+func (f *BngpolicerEntryDescriptor) EquivalentBngpolicerEntry(key string, oldEntry, newEntry *bngp.BngPolicerEntry) bool {
+	return proto.Equal(oldEntry, newEntry)
+}
+
+// Validate validates value before it is applied.
+func (f *BngpolicerEntryDescriptor) Validate(key string, bngpolicerEntry *bngp.BngPolicerEntry) error {
+	if bngpolicerEntry.GetName() == "" {
+		return kvs.NewInvalidValueError(ErrNameNotDefined, "name")
+	}
+	return nil
+}
+
+// Create uses vppcalls to pass Bng Policer configuration to VPP.
+func (f *BngpolicerEntryDescriptor) Create(key string, bngpolicerEntry *bngp.BngPolicerEntry) (metadata interface{}, err error) {
+	//Add Bngpolicer entry
+	err = f.bngpolicerEntryHandler.AddBngpolicerEntry(bngpolicerEntry)
+	if err != nil {
+		f.log.Error(err)
+	}
+	return nil, err
+
+}
+
+// Delete removes VPP BNG Policer configuration.
+func (f *BngpolicerEntryDescriptor) Delete(key string, bngpolicerEntry *bngp.BngPolicerEntry, metadata interface{}) error {
+	err := f.bngpolicerEntryHandler.DeleteBngpolicerEntry(bngpolicerEntry)
+	if err != nil {
+		f.log.Error(err)
+	}
+	return err
+}
