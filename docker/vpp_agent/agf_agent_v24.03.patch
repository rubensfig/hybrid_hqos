+	"go.ligato.io/vpp-agent/v3/plugins/vpp/binapi/vpp2402/vpe"
+)
+
+func init() {
+	msgs := vpp.Messages(
+		vpe.AllMessages,
+		memclnt.AllMessages,
+	)
