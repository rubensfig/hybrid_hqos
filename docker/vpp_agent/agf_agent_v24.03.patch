+// AddSPDInterface implements IPSec handler.
+func (h *IPSecVppHandler) AddSPDInterface(spdID uint32, ifaceCfg *ipsec.SecurityPolicyDatabase_Interface) error {
+	ifaceMeta, found := h.ifIndexes.LookupByName(ifaceCfg.Name)
