+// holds a list of NAT44 ED flags set
+type nat44EdFlags struct {
+	isTwiceNat     bool
+	isSelfTwiceNat bool
+	isOut2In       bool
+	isAddrOnly     bool
+	isOutside      bool
+	isInside       bool
+	isStatic       bool
+	isExtHostValid bool
+}
+
+// holds a list of NAT44 EI flags set
+type nat44EiFlags struct {
+	eiStaticMappingOnly  bool
+	eiConnectionTracking bool
