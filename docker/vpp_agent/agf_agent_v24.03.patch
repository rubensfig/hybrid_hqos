diff --git a/agf-dp-mgmt-plugins/proto/flowtable/flowtable.proto b/agf-dp-mgmt-plugins/proto/flowtable/flowtable.proto
new file mode 100644
index 000000000..a9e5948a4
--- /dev/null
+++ b/agf-dp-mgmt-plugins/proto/flowtable/flowtable.proto
@@ -0,0 +1,47 @@
+syntax = "proto3";
+
+package ligato.vpp.flowtable;
+
+option go_package = "_/agf-dp-mgmt-plugins/proto/flowtable;vpp_flowtable";
+
+//Enable Flowtable Qinq node on interface
+message FlowtableQinqIntf {
+
+    bool flowtableqinq_enable = 1;  /* flowtable enable or disable */
+    string interface = 2;     	/* interface name  */
+
+}
+
+//Enable Flowtable IP4 node on interface
+message FlowtableIP4Intf {
+
+    bool flowtableip4_enable = 1;  /* flowtable enable or disable */
+    string interface = 2;       /* interface name  */
+
+}
+
+
+// Add qinq entry to flowtable
+message FlowtableQinqEntry {
+
+
+    string source_mac = 1;      /* source MAC address */
+    uint32 s_tag = 2;           /* S tag - vlan id */
+    uint32 c_tag = 3;           /* C tag - vlan id */
+    uint32 flow_id = 4;          /* Flow id */
+    uint32 cpu_id = 5;          /* CPU worker id */
+
+}
+
+// Add IP4 entry to flowtable
+message FlowtableIP4Entry {
+
+    string ip_src = 1;      /* source IP address */
+    string ip_dst = 2;      /* destination IP address */
+    uint32 proto = 3;       /* protocol */
+    uint32 udp_src = 4;     /* udp source port */
+    uint32 udp_dst = 5;     /* udp destination port */
+    uint32 flow_id = 6;     /* Flow id */
+    uint32 cpu_id = 7;      /* CPU worker id */
+
+}
