+// incIP increments IP address and returns it.
+// Based on: https://play.golang.org/p/m8TNTtygK0
+func incIP(ip net.IP) net.IP {
+	retIP := make(net.IP, len(ip))
+	copy(retIP, ip)
+	for j := len(retIP) - 1; j >= 0; j-- {
+		retIP[j]++
+		if retIP[j] > 0 {
+			break
+		}
+	}
+	return retIP
+}
