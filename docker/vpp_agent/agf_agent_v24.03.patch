+package vpp2402
+
+import (
+	"fmt"
+	"net"
+
+	govppapi "go.fd.io/govpp/api"
+	"go.ligato.io/cn-infra/v2/logging"
+
+	vpp2402 "go.ligato.io/vpp-agent/v3/plugins/vpp/binapi/vpp2402"
