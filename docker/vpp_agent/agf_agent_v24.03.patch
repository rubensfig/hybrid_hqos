+
+// AgfencapVppAPI groups Agfencap VPP handler APIs.
+type AgfencapVppAPI interface {
+	AgfencapQinqIntfVppAPI
+	AgfencapQinqEntryVppAPI
+
+	AgfencapGtpuIntfVppAPI
+	AgfencapGtpuEntryVppAPI
+
+	AgfencapQinqPppoeIntfVppAPI
+	AgfencapQinqPppoeEntryVppAPI
+}
+
+var handler = vpp.RegisterHandler(vpp.HandlerDesc{
+	Name:       "vpp_agfencap",
+	HandlerAPI: (*AgfencapVppAPI)(nil),
+})
+
+// AgfencapQinqIntfVppAPI provides methods for enabling/dsiabling Agfencap Qinq
+type AgfencapQinqIntfVppAPI interface {
+	EnableAgfencapQinqIntf(agfencapqinqintf *encp.AgfEncapQinqIntf) error
+	DisableAgfencapQinqIntf(agfencapQinqIntf *encp.AgfEncapQinqIntf) error
+}
+
+// AgfencapGtpuIntfVppAPI provides methods for enabling/disabling Agfencap GTPU
+type AgfencapGtpuIntfVppAPI interface {
+	EnableAgfencapGtpuIntf(agfencapgtpuintf *encp.AgfEncapGtpuIntf) error
+	DisableAgfencapGtpuIntf(agfencapGtpuIntf *encp.AgfEncapGtpuIntf) error
+}
+
+// AgfencapQinqPppoeIntfVppAPI provides methods for enabling/dsiabling Agfencap Qinq PPPOE
+type AgfencapQinqPppoeIntfVppAPI interface {
