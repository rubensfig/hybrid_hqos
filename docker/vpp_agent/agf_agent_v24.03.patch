+
+type TelemetryHandler struct {
+	vpe vpe_vppcalls.VppCoreAPI
+}
+
+func NewTelemetryVppHandler(c vpp.Client) vppcalls.TelemetryVppAPI {
+	return &TelemetryHandler{
