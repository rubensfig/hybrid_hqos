+
+func (h *NatVppHandler) DefaultNat44GlobalConfig() *nat.Nat44Global {
+	return &nat.Nat44Global{
+		Forwarding:          false,
+		EndpointIndependent: false,
+		NatInterfaces:       nil,
+		AddressPool:         nil,
+		VirtualReassembly:   nil, // VirtualReassembly is not part of NAT API in VPP 20.01+ anymore
+	}
