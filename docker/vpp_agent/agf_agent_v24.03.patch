+func (h *FlowtableVppHandler) flowtableQinqEntryAdd(flowtableQinqEntry *flw.FlowtableQinqEntry) (err error) {
+
+	// parse MAC address
+	var mac []byte
+	if flowtableQinqEntry.SourceMac != "" {
+		mac, err = net.ParseMAC(flowtableQinqEntry.SourceMac)
+		if err != nil {
+			return err
+		}
+	}
+
+	// Add Flowtable Qinq entry
+	req := &vpp_flw.FlowtableAddQinqFlow{
+		SrcMac:  mac,
+		SvlanID: flowtableQinqEntry.STag,
+		CvlanID: flowtableQinqEntry.CTag,
+		FlowID:  flowtableQinqEntry.FlowId,
+		CPUID:   flowtableQinqEntry.CpuId,
+	}
+	reply := &vpp_flw.FlowtableAddQinqFlowReply{}
+
+	if err := h.callsChannel.SendRequest(req).ReceiveReply(reply); err != nil {
+		return err
+	}
+
+	return nil
+}
