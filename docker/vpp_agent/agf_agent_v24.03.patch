+// DeleteACL implements ACL handler.
+func (h *ACLVppHandler) DeleteACL(aclIndex uint32) error {
+	req := &vpp_acl.ACLDel{
+		ACLIndex: aclIndex,
+	}
+	reply := &vpp_acl.ACLDelReply{}
