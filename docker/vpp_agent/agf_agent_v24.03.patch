+package vpp2402
+
+import (
+	"errors"
+
+	vpp_bngp "_/agf-dp-mgmt-plugins/binapi/vpp2402/bng_policer"
+	bngp "_/agf-dp-mgmt-plugins/proto/bngpolicer"
+	"go.ligato.io/vpp-agent/v3/plugins/vpp/binapi/vpp2402/interface_types"
+)
+
+// EnableBngpolicerIntf enable BNG Policer node on Interface.
+func (h *BngpolicerVppHandler) EnableBngpolicerIntf(bngpolicerIntf *bngp.BngPolicerIntf) error {
+	return h.bngpolicerIntfEnableDisable(bngpolicerIntf, true)
+}
+
+// DisableBngpolicerIntf disable BNG Policer node on Interface.
+func (h *BngpolicerVppHandler) DisableBngpolicerIntf(bngpolicerIntf *bngp.BngPolicerIntf) error {
+	return h.bngpolicerIntfEnableDisable(bngpolicerIntf, false)
+}
+
+func (h *BngpolicerVppHandler) bngpolicerIntfEnableDisable(bngpolicerIntf *bngp.BngPolicerIntf, isEnable bool) (err error) {
+
+	ifaceMeta, found := h.ifIndexes.LookupByName(bngpolicerIntf.Interface)
+	if !found {
+		return errors.New("Bng Policer interface not found")
+	}
+
+	// Enable/Disable Bngpolicer on Interface
+	req := &vpp_bngp.BngPolicerEnableDisable{
+		SwIfIndex:     interface_types.InterfaceIndex(ifaceMeta.SwIfIndex),
+		EnableDisable: isEnable,
+	}
+
+	reply := &vpp_bngp.BngPolicerEnableDisableReply{}
+
+	if err := h.callsChannel.SendRequest(req).ReceiveReply(reply); err != nil {
+		return err
+	}
+
+	return nil
+}
