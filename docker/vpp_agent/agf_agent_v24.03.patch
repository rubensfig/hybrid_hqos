+func (h *ACLVppHandler) getIPRuleDetails(rule acl_types.ACLRule) (*acl.ACL_Rule, error) {
+	// Resolve rule actions
+	aclAction, err := h.resolveRuleAction(rule.IsPermit)
+	if err != nil {
+		return nil, err
+	}
+
+	return &acl.ACL_Rule{
+		Action: aclAction,
+		IpRule: h.getIPRuleMatches(rule),
+	}, nil
+}
