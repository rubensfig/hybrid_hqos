+// AgfencapQinqPppoeEntryDescriptor teaches KVScheduler how to configure VPP Agfencap entries.
+type AgfencapQinqPppoeEntryDescriptor struct {
+	log                           logging.Logger
+	agfencapQinqPppoeEntryHandler vppcalls.AgfencapQinqPppoeEntryVppAPI
+}
+
+// NewAgfencapQinqPppoeEntryDescriptor creates a new instance of the descriptor.
+func NewAgfencapQinqPppoeEntryDescriptor(agfencapQinqPppoeEntryHandler vppcalls.AgfencapQinqPppoeEntryVppAPI, log logging.PluginLogger) *AgfencapQinqPppoeEntryDescriptor {
+	return &AgfencapQinqPppoeEntryDescriptor{
+		agfencapQinqPppoeEntryHandler: agfencapQinqPppoeEntryHandler,
+		log:                           log.NewLogger("agfencap-qinqpppoeentry-descriptor"),
+	}
+}
+
+// GetDescriptor returns descriptor suitable for registration (via adapter) with the KVScheduler.
+func (f *AgfencapQinqPppoeEntryDescriptor) GetDescriptor() *adapter.AgfEncapQinqPppoeEntryDescriptor {
+	return &adapter.AgfEncapQinqPppoeEntryDescriptor{
+		Name:            AgfencapQinqPppoeEntryDescriptorName,
+		NBKeyPrefix:     encp.ModelAgfEncapQinqPppoeEntry.KeyPrefix(),
+		ValueTypeName:   encp.ModelAgfEncapQinqPppoeEntry.ProtoName(),
+		KeySelector:     encp.ModelAgfEncapQinqPppoeEntry.IsKeyValid,
+		KeyLabel:        encp.ModelAgfEncapQinqPppoeEntry.StripKeyPrefix,
+		ValueComparator: f.EquivalentAgfencapQinqPppoeEntry,
+		Validate:        f.Validate,
+		Create:          f.Create,
+		Delete:          f.Delete,
+	}
+}
+
+// EquivalentAgfencapQinqPppoeEntry is case-insensitive comparison function for agfencap Qinq PPPOE Entry.
+func (f *AgfencapQinqPppoeEntryDescriptor) EquivalentAgfencapQinqPppoeEntry(key string, oldQinqPppoeEntry, newQinqPppoeEntry *encp.AgfEncapQinqPppoeEntry) bool {
+	// parameters compared by proto equal
+	return proto.Equal(oldQinqPppoeEntry, newQinqPppoeEntry)
+}
+
+// Validate validates value before it is applied.
+func (f *AgfencapQinqPppoeEntryDescriptor) Validate(key string, agfencapQinqPppoeEntry *encp.AgfEncapQinqPppoeEntry) error {
+	if agfencapQinqPppoeEntry.GetSrcMac() == "" {
+		return kvs.NewInvalidValueError(ErrQinqPppoeMacNotDefined, "src mac")
+	}
+
+	if agfencapQinqPppoeEntry.GetDstMac() == "" {
+		return kvs.NewInvalidValueError(ErrQinqPppoeMacNotDefined, "dst mac")
+	}
+	return nil
+}
+
+// Create uses vppcalls to pass Agfencap configuration to VPP.
+func (f *AgfencapQinqPppoeEntryDescriptor) Create(key string, agfencapQinqPppoeEntry *encp.AgfEncapQinqPppoeEntry) (metadata interface{}, err error) {
+	//Add Agfencap Qinq entry
+	err = f.agfencapQinqPppoeEntryHandler.AddAgfencapQinqPppoeEntry(agfencapQinqPppoeEntry)
+	if err != nil {
+		f.log.Error(err)
+	}
+	return nil, err
+}
+
+// Delete uses vppcalls to pass Agfencap configuration to VPP for deletion.
+func (f *AgfencapQinqPppoeEntryDescriptor) Delete(key string, agfencapQinqPppoeEntry *encp.AgfEncapQinqPppoeEntry, metadata interface{}) error {
+	//Delete Agfencap Qinq entry
+	err := f.agfencapQinqPppoeEntryHandler.DeleteAgfencapQinqPppoeEntry(agfencapQinqPppoeEntry)
+	if err != nil {
+		f.log.Error(err)
+	}
+	return err
+}
