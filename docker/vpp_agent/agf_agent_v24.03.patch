+	"go.ligato.io/vpp-agent/v3/plugins/vpp/binapi/vpp2402/ip_types"
+)
+
+// AddAgfencapGtpuEntry creates Agfencap Gtpu entry.
+func (h *AgfencapVppHandler) AddAgfencapGtpuEntry(agfencapGtpuEntry *encp.AgfEncapGtpuEntry) error {
+	return h.agfencapGtpuEntryAdd(agfencapGtpuEntry)
+}
+
+// DeleteAgfencapGtpuEntry deletes Agfencap Gtpu entry.
+func (h *AgfencapVppHandler) DeleteAgfencapGtpuEntry(agfencapGtpuEntry *encp.AgfEncapGtpuEntry) error {
+	return h.agfencapGtpuEntryDelete(agfencapGtpuEntry)
+}
+
+//Calls VPP binary API to add Agfencap Gtpu Entry
+func (h *AgfencapVppHandler) agfencapGtpuEntryAdd(agfencapGtpuEntry *encp.AgfEncapGtpuEntry) (err error) {
+
+	// parse source IP address
+	srcIPAddrByte, err := ipTo4Address(agfencapGtpuEntry.SrcIp)
+	if err != nil {
+		return errors.Errorf("Unable to parse source IP address %s: %v", agfencapGtpuEntry.SrcIp, err)
+	}
+
+	// parse destination IP address
+	dstIPAddrByte, err := ipTo4Address(agfencapGtpuEntry.DstIp)
+	if err != nil {
+		return errors.Errorf("Unable to parse destination IP address %s: %v", agfencapGtpuEntry.DstIp, err)
+	}
+
+	// Add Agfencap GTPU entry
+	req := &vpp_encp.AgfEncapGtpuRuleAdd{
+		SrcIP:   srcIPAddrByte,
+		DstIP:   dstIPAddrByte,
+		Dscp:    uint8(agfencapGtpuEntry.Dscp),
+		DstPort: agfencapGtpuEntry.DstPort,
+		FlowID:  agfencapGtpuEntry.FlowId,
+		Teid:    agfencapGtpuEntry.TeId,
+	}
+	reply := &vpp_encp.AgfEncapGtpuRuleAddReply{}
+
+	if err := h.callsChannel.SendRequest(req).ReceiveReply(reply); err != nil {
+		return err
+	}
+
+	return nil
+}
+
+//Calls VPP binary API to delete Agfencap Gtpu Entry
+func (h *AgfencapVppHandler) agfencapGtpuEntryDelete(agfencapGtpuEntry *encp.AgfEncapGtpuEntry) (err error) {
+
+	// Delete Agfencap GTPU entry
+	req := &vpp_encp.AgfEncapGtpuRuleDel{
+		FlowID: agfencapGtpuEntry.FlowId,
+	}
+	reply := &vpp_encp.AgfEncapGtpuRuleDelReply{}
+
+	if err := h.callsChannel.SendRequest(req).ReceiveReply(reply); err != nil {
+		return err
+	}
+	return nil
+}
+
+func ipTo4Address(ipStr string) (addr ip_types.IP4Address, err error) {
+	netIP := net.ParseIP(ipStr)
+	if netIP == nil {
+		return ip_types.IP4Address{}, fmt.Errorf("invalid IP: %q", ipStr)
+	}
+	if ip4 := netIP.To4(); ip4 != nil {
+		var ip4Addr ip_types.IP4Address
+		copy(ip4Addr[:], netIP.To4())
+		addr = ip4Addr
+	} else {
+		return ip_types.IP4Address{}, fmt.Errorf("required IPv4, provided: %q", ipStr)
+	}
+	return
+}
