+)
+
+const (
+	// BlocklistIpv45TupleDescriptorName is the name of the descriptor for vpp firewall Blocklist Entry.
+	BlocklistIpv45TupleDescriptorName = "vpp-firewall-blocklist-ipv45tuple"
+)
+
+// Validation errors:
+var (
+	// ErrSrcIpNotDefined returned when source IP address in confiugration is empty string.
+	ErrBlkSrcIPNotDefined = errors.New("invalid source IP address for Blocklist Ipv4 5Tuple rule")
+
+	// ErrDstIpNotDefined returned when destination IP address in confiugration is empty string.
+	ErrBlkDstIPNotDefined = errors.New("invalid destination IP address for Blocklist Ipv4 5Tuple Rule")
+)
+
+// BlocklistIpv45TupleDescriptor teaches KVScheduler how to configure VPP Firewall Blocklist Ipv4 5tuple entries.
+type BlocklistIpv45TupleDescriptor struct {
+	log                        logging.Logger
+	blocklistIPv45TupleHandler vppcalls.BlocklistRuleIpv45TupleVppAPI
+}
+
+// NewBlocklistIpv45TupleDescriptor creates a new instance of the Blocklist Ipv4-5Tuple descriptor.
+func NewBlocklistIpv45TupleDescriptor(blocklistIPv45TupleHandler vppcalls.BlocklistRuleIpv45TupleVppAPI, log logging.PluginLogger) *BlocklistIpv45TupleDescriptor {
+	return &BlocklistIpv45TupleDescriptor{
+		blocklistIPv45TupleHandler: blocklistIPv45TupleHandler,
+		log:                        log.NewLogger("firewall-blocklist-ipv45tuple-descriptor"),
+	}
+}
+
+// GetDescriptor returns descriptor suitable for registration (via adapter) with the KVScheduler.
+func (f *BlocklistIpv45TupleDescriptor) GetDescriptor() *adapter.BlocklistIpv45TupleDescriptor {
+	return &adapter.BlocklistIpv45TupleDescriptor{
+		Name:            BlocklistIpv45TupleDescriptorName,
+		NBKeyPrefix:     frwl.ModelBlocklistIpv45tuple.KeyPrefix(),
+		ValueTypeName:   frwl.ModelBlocklistIpv45tuple.ProtoName(),
+		KeySelector:     frwl.ModelBlocklistIpv45tuple.IsKeyValid,
+		KeyLabel:        frwl.ModelBlocklistIpv45tuple.StripKeyPrefix,
+		ValueComparator: f.EquivalentBlocklistIpv45Tuple,
+		Validate:        f.Validate,
+		Create:          f.Create,
+		Delete:          f.Delete,
+	}
+}
+
+// EquivalentBlocklistIpv45Tuple is case-insensitive comparison function for firewall Blocklist Ipv4 5tuple Rule.
+func (f *BlocklistIpv45TupleDescriptor) EquivalentBlocklistIpv45Tuple(key string, oldIpv45Tuple, newIpv45Tuple *frwl.BlocklistRuleIpv45Tuple) bool {
+	return proto.Equal(oldIpv45Tuple, newIpv45Tuple)
+}
+
+// Validate validates value before it is applied.
+func (f *BlocklistIpv45TupleDescriptor) Validate(key string, blocklistIpv45Tuple *frwl.BlocklistRuleIpv45Tuple) error {
+	if blocklistIpv45Tuple.GetIpSrc() == "" {
+		return kvs.NewInvalidValueError(ErrBlkSrcIPNotDefined, "src-ip")
+	}
+	if blocklistIpv45Tuple.GetIpDst() == "" {
+		return kvs.NewInvalidValueError(ErrBlkDstIPNotDefined, "dst-ip")
+	}
+	return nil
+}
+
+// Create uses vppcalls to pass Blocklist configuration to VPP.
+func (f *BlocklistIpv45TupleDescriptor) Create(key string, blocklistIpv45Tuple *frwl.BlocklistRuleIpv45Tuple) (metadata interface{}, err error) {
+	//Add Blocklist entry
+	err = f.blocklistIPv45TupleHandler.AddBlocklistRuleIpv45Tuple(blocklistIpv45Tuple)
+	if err != nil {
+		f.log.Error(err)
+	}
+	return nil, err
+}
+
+// Delete removes VPP Blocklist IPv4-5Tuple configuration.
+func (f *BlocklistIpv45TupleDescriptor) Delete(key string, blocklistIpv45Tuple *frwl.BlocklistRuleIpv45Tuple, metadata interface{}) error {
+	err := f.blocklistIPv45TupleHandler.DeleteBlocklistRuleIpv45Tuple(blocklistIpv45Tuple)
+	if err != nil {
+		f.log.Error(err)
+	}
+	return err
+}
