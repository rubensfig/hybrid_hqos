+// NewFlowtableIP4IntfDescriptor creates a new instance of the descriptor.
+func NewFlowtableIP4IntfDescriptor(flowtableHandler vppcalls.FlowtableVppAPI, log logging.PluginLogger) *FlowtableIP4IntfDescriptor {
