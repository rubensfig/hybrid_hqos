+// Validation errors:
+var (
+	// ErrQinqPppoeMacNotDefined returned when mac address in confiugration is empty string.
+	ErrQinqPppoeMacNotDefined = errors.New("invalid mac address for Agfencap qinq pppoe entry")
+)
