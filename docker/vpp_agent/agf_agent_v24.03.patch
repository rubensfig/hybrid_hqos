+	"go.ligato.io/vpp-agent/v3/plugins/vpp/ifplugin/ifaceidx"
+)
+
+func init() {
+	// Register this handler implementation for VPP 24.02 in the vppcalls package.
+	vppcalls.AddFirewallHandlerVersion(vpp2402.Version, frwlba.AllMessages(), newFirewallVppHandler)
+}
+
+//FirewallVppHandler is accessor for Firewall-related vppcalls methods.
+type FirewallVppHandler struct {
+	callsChannel govppapi.Channel
+	ifIndexes    ifaceidx.IfaceMetadataIndex
+	log          logging.Logger
+}
+
+// NewFirewallVppHandler creates new instance of Firewall vppcalls handler.
+func newFirewallVppHandler(ch govppapi.Channel, ifIdx ifaceidx.IfaceMetadataIndex, log logging.Logger,
+) vppcalls.FirewallVppAPI {
+	return &FirewallVppHandler{
+		callsChannel: ch,
+		ifIndexes:    ifIdx,
+		log:          log,
+	}
+}
+
+func ipTo4Address(ipStr string) (addr ip_types.IP4Address, err error) {
+	netIP := net.ParseIP(ipStr)
+	if netIP == nil {
+		return ip_types.IP4Address{}, fmt.Errorf("invalid IP: %q", ipStr)
+	}
+	if ip4 := netIP.To4(); ip4 != nil {
+		var ip4Addr ip_types.IP4Address
+		copy(ip4Addr[:], netIP.To4())
+		addr = ip4Addr
+	} else {
+		return ip_types.IP4Address{}, fmt.Errorf("required IPv4, provided: %q", ipStr)
+	}
+	return
+}
