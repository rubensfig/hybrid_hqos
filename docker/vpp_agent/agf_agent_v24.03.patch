+	"go.ligato.io/vpp-agent/v3/plugins/vpp/ifplugin/ifaceidx"
+)
+
+// BngpolicerVppAPI groups Bngpolicer Vpp APIs.
+type BngpolicerVppAPI interface {
+	BngpolicerIntfVppAPI
+	BngpolicerEntryVppAPI
+}
+
+var handler = vpp.RegisterHandler(vpp.HandlerDesc{
+	Name:       "vpp_bngpolicer",
+	HandlerAPI: (*BngpolicerVppAPI)(nil),
+})
+
+// BngpolicerIntfVppAPI provides methods for enabling/disabling bngpolicer on interface
+type BngpolicerIntfVppAPI interface {
+	EnableBngpolicerIntf(bngpolicerintf *bngp.BngPolicerIntf) error
+	DisableBngpolicerIntf(bngpolicerIntf *bngp.BngPolicerIntf) error
+}
+
+// BngpolicerEntryVppAPI provides methods for managing BNG Policer entries.
+type BngpolicerEntryVppAPI interface {
+	AddBngpolicerEntry(bngpolicerEntry *bngp.BngPolicerEntry) error
+	DeleteBngpolicerEntry(bngpolicerEntry *bngp.BngPolicerEntry) error
+}
+
+// BngpolicerDetails is the wrapper structure for the BNG Policer entry northbound API structure.
+type BngpolicerDetails struct {
+	BngpolicerEntry *bngp.BngPolicerEntry
+}
+
+// AddBngpolicerHandlerVersion is used to register implementations of VPP handler API
+// interface for a specific VPP version.
+func AddBngpolicerHandlerVersion(version vpp.Version, msgs []govppapi.Message,
+	h func(ch govppapi.Channel, ifIdx ifaceidx.IfaceMetadataIndex, log logging.Logger) BngpolicerVppAPI,
+) {
+	handler.AddVersion(vpp.HandlerVersion{
+		Version: version,
+		Check: func(c vpp.Client) error {
+			ch, err := c.NewAPIChannel()
+			if err != nil {
+				return err
+			}
+			return ch.CheckCompatiblity(msgs...)
+		},
+		NewHandler: func(c vpp.Client, a ...interface{}) vpp.HandlerAPI {
+			ch, err := c.NewAPIChannel()
+			if err != nil {
+				return err
+			}
+			return h(ch, a[0].(ifaceidx.IfaceMetadataIndex), a[1].(logging.Logger))
+		},
+	})
+}
+
+// CompatibleBngpolicerVppHandler checks all the registered implementations to find the
+// compatible handler implementation.
+func CompatibleBngpolicerVppHandler(c vpp.Client, ifIdx ifaceidx.IfaceMetadataIndex, log logging.Logger) BngpolicerVppAPI {
+	if v := handler.FindCompatibleVersion(c); v != nil {
+		return v.NewHandler(c, ifIdx, log).(BngpolicerVppAPI)
+	}
+	return nil
+}
