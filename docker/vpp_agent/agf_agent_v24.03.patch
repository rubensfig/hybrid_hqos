+package vpp2402
+
+import (
+	"fmt"
+	"net"
+
+	vpp_flw "_/agf-dp-mgmt-plugins/binapi/vpp2402/flowtable"
+	flw "_/agf-dp-mgmt-plugins/proto/flowtable"
+
+	"github.com/pkg/errors"
+	"go.ligato.io/vpp-agent/v3/plugins/vpp/binapi/vpp2402/ip_types"
+)
+
+// AddFlowtableIP4Entry creates Flowtable IP4 entry.
+func (h *FlowtableVppHandler) AddFlowtableIP4Entry(flowtableIP4Entry *flw.FlowtableIP4Entry) error {
+	return h.flowtableIP4EntryAdd(flowtableIP4Entry)
+}
+
+// DeleteFlowtableIP4Entry deletes Flowtable IP4 entry.
+func (h *FlowtableVppHandler) DeleteFlowtableIP4Entry(flowtableIP4Entry *flw.FlowtableIP4Entry) error {
+	return h.flowtableIP4EntryDelete(flowtableIP4Entry)
+}
+
+//Calls VPP binary API to add Flowtable IP4 Entry
+func (h *FlowtableVppHandler) flowtableIP4EntryAdd(flowtableIP4Entry *flw.FlowtableIP4Entry) (err error) {
+
+	// parse source IP address
+	srcIPAddrByte, err := ipTo4Address(flowtableIP4Entry.IpSrc)
+	if err != nil {
+		return errors.Errorf("Unable to parse source IP address %s: %v", flowtableIP4Entry.IpSrc, err)
+	}
+
+	// parse destination IP address
+	dstIPAddrByte, err := ipTo4Address(flowtableIP4Entry.IpDst)
+	if err != nil {
+		return errors.Errorf("Unable to parse destination IP address %s: %v", flowtableIP4Entry.IpDst, err)
+	}
+
+	// Add Flowtable IP4 entry
+	req := &vpp_flw.FlowtableAddIP4Flow{
+		IPSrc:   srcIPAddrByte,
+		IPDst:   dstIPAddrByte,
+		IPProto: uint8(flowtableIP4Entry.Proto),
+		UDPSrc:  uint16(flowtableIP4Entry.UdpSrc),
+		UDPDst:  uint16(flowtableIP4Entry.UdpDst),
+		FlowID:  flowtableIP4Entry.FlowId,
+		CPUID:   flowtableIP4Entry.CpuId,
+	}
+	reply := &vpp_flw.FlowtableAddIP4FlowReply{}
+
+	if err := h.callsChannel.SendRequest(req).ReceiveReply(reply); err != nil {
+		return err
+	}
+
+	return nil
+}
+
+//Calls VPP binary API to delete Flowtable IP4 Entry
+func (h *FlowtableVppHandler) flowtableIP4EntryDelete(flowtableIP4Entry *flw.FlowtableIP4Entry) (err error) {
+
+	// parse source IP address
+	srcIPAddrByte, err := ipTo4Address(flowtableIP4Entry.IpSrc)
+	if err != nil {
+		return errors.Errorf("Unable to parse source IP address %s: %v", flowtableIP4Entry.IpSrc, err)
+	}
+
+	// parse destination IP address
+	dstIPAddrByte, err := ipTo4Address(flowtableIP4Entry.IpDst)
+	if err != nil {
+		return errors.Errorf("Unable to parse destination IP address %s: %v", flowtableIP4Entry.IpDst, err)
+	}
+
+	req := &vpp_flw.FlowtableDelIP4Flow{
+		IPSrc:   srcIPAddrByte,
+		IPDst:   dstIPAddrByte,
+		IPProto: uint8(flowtableIP4Entry.Proto),
+		UDPSrc:  uint16(flowtableIP4Entry.UdpSrc),
+		UDPDst:  uint16(flowtableIP4Entry.UdpDst),
+		CPUID:   flowtableIP4Entry.CpuId,
+	}
+	reply := &vpp_flw.FlowtableDelIP4FlowReply{}
+
+	if err := h.callsChannel.SendRequest(req).ReceiveReply(reply); err != nil {
+		return err
+	}
+
+	return nil
+}
+
+func ipTo4Address(ipStr string) (addr ip_types.IP4Address, err error) {
+	netIP := net.ParseIP(ipStr)
+	if netIP == nil {
+		return ip_types.IP4Address{}, fmt.Errorf("invalid IP: %q", ipStr)
+	}
+	if ip4 := netIP.To4(); ip4 != nil {
+		var ip4Addr ip_types.IP4Address
+		copy(ip4Addr[:], netIP.To4())
+		addr = ip4Addr
+	} else {
+		return ip_types.IP4Address{}, fmt.Errorf("required IPv4, provided: %q", ipStr)
+	}
+	return
+}
