+++ b/agf-dp-mgmt-plugins/proto/bngpolicer/bngpolicer.proto
@@ -0,0 +1,65 @@
+syntax = "proto3";
+
+package ligato.vpp.bngpolicer;
+
+option go_package = "_/agf-dp-mgmt-plugins/proto/bngpolicer;vpp_bngpolicer";
+
+//Enable BNG Policer node on interface
+message BngPolicerIntf {
+
+    bool enable = 1;        	/* bng policer enable or disable */
+    string interface = 2;   	/* interface name */
+}
+
+
+// Add BNG Policer entry
+message BngPolicerEntry {
+
+    string name = 1;            /* name - bng_policer name */
+    uint32 flow_id = 2;         /* flow_id - the flow id */
+    uint32 cir = 3;             /* cir - CIR */
+    uint32 eir = 4;             /* eir - EIR */
+    uint64 cb = 5;              /* cb - Committed Burst */
+    uint64 eb = 6;              /* eb - Excess or Peak Burst*/
+
+   enum RateType {
+        KBPS = 0;
+        PPS = 1;
+    };
+
+    RateType rate_type = 7;     /* rate_type - rate type */
+
+    enum RoundType {
+        CLOSEST = 0;
+        UP = 1;
+        DOWN = 2;
+    };
+
+    RoundType round_type = 8;   /* round_type - rounding type */
+
+    enum BngPolicerType {
+        RFC_1R2C = 0;
+        RFC_1R3C = 1;
+        RFC2698_2R3C = 2;
+        RFC4115_4115 = 3;
+        RFCMEF5CF1_2R3C = 4;
+    };
+
+    BngPolicerType type = 9;    /* type - bng_policer algorithm */
+    uint32 color_aware = 10;    /* color_aware - 0=color-blind, 1=color-aware */
+
+    enum ActionType {
+        DROP = 0;
+        TRANSMIT = 1;
+        MARK_AND_TRANSMIT = 2;
+    };
+
+
+    ActionType conform_action_type = 11;   /* conform_action_type - conform action type */
+    uint32 conform_dscp = 12;              /* conform_dscp - DSCP for conform mar-and-transmit action */
+    ActionType exceed_action_type = 13;    /* exceed_action_type - exceed action type */
+    uint32 exceed_dscp = 14;               /* exceed_dscp - DSCP for exceed mar-and-transmit action */
+    ActionType violate_action_type = 15;   /* violate_action_type - violate action type */
+    uint32 violate_dscp = 16;              /* violate_dscp - DSCP for violate mar-and-transmit action */
+
+}
