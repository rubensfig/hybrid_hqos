+// AddSPD implements IPSec handler.
+func (h *IPSecVppHandler) AddSPD(spdID uint32) error {
+	return h.spdAddDel(spdID, true)
+}
+
+// DeleteSPD implements IPSec handler.
+func (h *IPSecVppHandler) DeleteSPD(spdID uint32) error {
