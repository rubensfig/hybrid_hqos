+	DisableAgfencapQinqPppoeIntf(agfencapQinqPppoeIntf *encp.AgfEncapQinqPppoeIntf) error
+}
+
+// AgfencapQinqEntryVppAPI provides methods for managing AGF Encap Qinq entries.
+type AgfencapQinqEntryVppAPI interface {
+	AddAgfencapQinqEntry(agfencapQinqEntry *encp.AgfEncapQinqEntry) error
+	DeleteAgfencapQinqEntry(agfencapQinqEntry *encp.AgfEncapQinqEntry) error
+}
+
+// AgfencapGtpuEntryVppAPI provides methods for managing AGF Encap GTPU entries.
+type AgfencapGtpuEntryVppAPI interface {
+	AddAgfencapGtpuEntry(agfencapGtpuEntry *encp.AgfEncapGtpuEntry) error
+	DeleteAgfencapGtpuEntry(agfencapGtpuEntry *encp.AgfEncapGtpuEntry) error
+}
+
+// AgfencapQinqPppoeEntryVppAPI provides methods for managing AGF Encap Qinq PPPOE entries.
+type AgfencapQinqPppoeEntryVppAPI interface {
+	AddAgfencapQinqPppoeEntry(agfencapQinqPppoeEntry *encp.AgfEncapQinqPppoeEntry) error
+	DeleteAgfencapQinqPppoeEntry(agfencapQinqPppoeEntry *encp.AgfEncapQinqPppoeEntry) error
+}
+
+// AddAgfencapHandlerVersion is used to register implementations of VPP handler API
+// interface for a specific VPP version.
+func AddAgfencapHandlerVersion(version vpp.Version, msgs []govppapi.Message,
+	h func(ch govppapi.Channel, ifIdx ifaceidx.IfaceMetadataIndex, log logging.Logger) AgfencapVppAPI,
+) {
+	handler.AddVersion(vpp.HandlerVersion{
+		Version: version,
+		Check: func(c vpp.Client) error {
+			ch, err := c.NewAPIChannel()
+			if err != nil {
+				return err
+			}
+			return ch.CheckCompatiblity(msgs...)
+		},
+		NewHandler: func(c vpp.Client, a ...interface{}) vpp.HandlerAPI {
+			ch, err := c.NewAPIChannel()
+			if err != nil {
+				return err
+			}
+			return h(ch, a[0].(ifaceidx.IfaceMetadataIndex), a[1].(logging.Logger))
+		},
+	})
+}
+
+// CompatibleAgfencapVppHandler checks all the registered implementations to find the
+// compatible handler implementation.
+func CompatibleAgfencapVppHandler(c vpp.Client, ifIdx ifaceidx.IfaceMetadataIndex, log logging.Logger) AgfencapVppAPI {
