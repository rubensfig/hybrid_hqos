+// FlowtableIP4IntfDescriptor teaches KVScheduler how to configure VPP Flowtable IP4 Interface.
+type FlowtableIP4IntfDescriptor struct {
+	log              logging.Logger
+	flowtableHandler vppcalls.FlowtableVppAPI
+}
