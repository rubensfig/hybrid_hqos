+	vpp_bngp "_/agf-dp-mgmt-plugins/binapi/vpp2402/bng_policer"
+	bngp "_/agf-dp-mgmt-plugins/proto/bngpolicer"
+)
+
+// AddBngpolicerEntry creates BNG Policer entry.
+func (h *BngpolicerVppHandler) AddBngpolicerEntry(bngpolicerEntry *bngp.BngPolicerEntry) error {
+	return h.bngpolicerEntryAddDel(bngpolicerEntry, true)
+}
+
+// DeleteBngpolicerEntry removes BNG Policer entry.
+func (h *BngpolicerVppHandler) DeleteBngpolicerEntry(bngpolicerEntry *bngp.BngPolicerEntry) error {
+	return h.bngpolicerEntryAddDel(bngpolicerEntry, false)
+}
+
+//Calls VPP binary API to add or delete BNG Policer entry
+func (h *BngpolicerVppHandler) bngpolicerEntryAddDel(bngpolicerEntry *bngp.BngPolicerEntry, isAdd bool) (err error) {
+
+	var isAddInt uint8 = 0
+	if isAdd {
+		isAddInt = 1
+	}
+
+	// Add BNG Policer Item entry
+	req := &vpp_bngp.BngPolicerAddDel{
+		IsAdd:             isAddInt,
+		Name:              []byte(bngpolicerEntry.Name),
+		FlowID:            bngpolicerEntry.FlowId,
+		Cir:               bngpolicerEntry.Cir,
+		Eir:               bngpolicerEntry.Eir,
+		Cb:                bngpolicerEntry.Cb,
+		Eb:                bngpolicerEntry.Eb,
+		RateType:          uint8(bngpolicerEntry.RateType),
+		RoundType:         uint8(bngpolicerEntry.RoundType),
+		Type:              uint8(bngpolicerEntry.Type),
+		ColorAware:        uint8(bngpolicerEntry.ColorAware),
+		ConformActionType: uint8(bngpolicerEntry.ConformActionType),
+		ConformDscp:       uint8(bngpolicerEntry.ConformDscp),
+		ExceedActionType:  uint8(bngpolicerEntry.ExceedActionType),
+		ExceedDscp:        uint8(bngpolicerEntry.ExceedDscp),
+		ViolateActionType: uint8(bngpolicerEntry.ViolateActionType),
+		ViolateDscp:       uint8(bngpolicerEntry.ViolateDscp),
+	}
+	reply := &vpp_bngp.BngPolicerAddDelReply{}
+
+	if err := h.callsChannel.SendRequest(req).ReceiveReply(reply); err != nil {
+		return err
+	}
+
+	return nil
+}
