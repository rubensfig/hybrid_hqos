+package vpp2402
+
+import (
+	"net"
+	"strings"
+
+	"github.com/pkg/errors"
+
+	"go.ligato.io/vpp-agent/v3/plugins/vpp/binapi/vpp2402/interface_types"
+	"go.ligato.io/vpp-agent/v3/plugins/vpp/binapi/vpp2402/ip_types"
