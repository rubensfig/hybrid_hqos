+
+package descriptor
+
+import (
+	"go.ligato.io/cn-infra/v2/logging"
+
+	"_/agf-dp-mgmt-plugins/flowtableplugin/descriptor/adapter"
+	"_/agf-dp-mgmt-plugins/flowtableplugin/vppcalls"
+	flw "_/agf-dp-mgmt-plugins/proto/flowtable"
+
+	kvs "go.ligato.io/vpp-agent/v3/plugins/kvscheduler/api"
+	interfaces "go.ligato.io/vpp-agent/v3/proto/ligato/vpp/interfaces"
+)
+
+const (
+	// FlowtableQinqIntfDescriptorName is the name of the descriptor for vpp flowtable interface.
+	FlowtableQinqIntfDescriptorName = "vpp-flowtable-qinqintf"
+
+	// dependency labels
+	flwQinqInterfaceDep = "interface-exists"
+)
+
+// FlowtableQinqIntfDescriptor teaches KVScheduler how to configure VPP Flowtable Interface entries.
+type FlowtableQinqIntfDescriptor struct {
+	log              logging.Logger
+	flowtableHandler vppcalls.FlowtableVppAPI
+}
+
+// NewFlowtableQinqIntfDescriptor creates a new instance of the descriptor.
+func NewFlowtableQinqIntfDescriptor(flowtableHandler vppcalls.FlowtableVppAPI, log logging.PluginLogger) *FlowtableQinqIntfDescriptor {
+	return &FlowtableQinqIntfDescriptor{
+		flowtableHandler: flowtableHandler,
+		log:              log.NewLogger("flowtable-qinqintf-descriptor"),
+	}
+}
+
+// GetDescriptor for Flowtable Qinq Interface
+func (f *FlowtableQinqIntfDescriptor) GetDescriptor() *adapter.FlowtableQinqIntfDescriptor {
+	return &adapter.FlowtableQinqIntfDescriptor{
+		Name:          FlowtableQinqIntfDescriptorName,
+		NBKeyPrefix:   flw.ModelFlowtableQinqIntf.KeyPrefix(),
+		ValueTypeName: flw.ModelFlowtableQinqIntf.ProtoName(),
+		KeySelector:   flw.ModelFlowtableQinqIntf.IsKeyValid,
+		KeyLabel:      flw.ModelFlowtableQinqIntf.StripKeyPrefix,
+		Create:        f.Create,
+		Delete:        f.Delete,
+		Dependencies:  f.DependenciesQinq,
+	}
+}
+
+// Create uses vppcalls to pass Flowtable configuration for interface to VPP.
+func (f *FlowtableQinqIntfDescriptor) Create(key string, flowtableQinqIntf *flw.FlowtableQinqIntf) (metadata interface{}, err error) {
+	err = f.flowtableHandler.EnableFlowtableQinqIntf(flowtableQinqIntf)
+	if err != nil {
+		f.log.Error(err)
+	}
+	return nil, err
+}
+
+// Delete uses vppcalls to remove Flowtable configuration for interface.
+func (f *FlowtableQinqIntfDescriptor) Delete(key string, flowtableQinqIntf *flw.FlowtableQinqIntf, metadata interface{}) (err error) {
+	err = f.flowtableHandler.DisableFlowtableQinqIntf(flowtableQinqIntf)
+	if err != nil {
+		f.log.Error(err)
+	}
+	return err
+}
+
+// DependenciesQinq lists the interface as a dependency  of the given value.
+func (f *FlowtableQinqIntfDescriptor) DependenciesQinq(key string, flwQinqIface *flw.FlowtableQinqIntf) (deps []kvs.Dependency) {
+	return []kvs.Dependency{
+		{
+			Label: flwQinqInterfaceDep,
+			Key:   interfaces.InterfaceKey(flwQinqIface.Interface),
+		},
+	}
+}
