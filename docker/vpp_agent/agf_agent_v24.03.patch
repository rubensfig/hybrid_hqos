+package vpp2402
+
+import (
+	"net"
+
+	vpp_dhcp "go.ligato.io/vpp-agent/v3/plugins/vpp/binapi/vpp2402/dhcp"
+	"go.ligato.io/vpp-agent/v3/plugins/vpp/binapi/vpp2402/ip_types"
