+	"go.ligato.io/vpp-agent/v3/plugins/govppmux"
+	kvs "go.ligato.io/vpp-agent/v3/plugins/kvscheduler/api"
+	"go.ligato.io/vpp-agent/v3/plugins/vpp/ifplugin"
+
+	//  Register vppcalls implementation for VPP 24.02
+	_ "_/agf-dp-mgmt-plugins/flowtableplugin/vppcalls/vpp2402"
+
+)
+
+// Deps lists dependencies of the Flowtable plugin.
+type Deps struct {
+	infra.PluginDeps
+	KVScheduler kvs.KVScheduler
+	IfPlugin    ifplugin.API
+	VPP         govppmux.API
+	StatusCheck statuscheck.PluginStatusWriter
+}
+
+// FlowtablePlugin is a plugin that configures VPP flowtable using GoVPP
+type FlowtablePlugin struct {
+	Deps
+
+	// handlers
+	flowtableHandler vppcalls.FlowtableVppAPI
+
+	// descriptors
+	flowtableQinqIfaceDescriptor *descriptor.FlowtableQinqIntfDescriptor
+	flowtableQinqEntryDescriptor *descriptor.FlowtableQinqEntryDescriptor
+
+	flowtableIP4IfaceDescriptor *descriptor.FlowtableIP4IntfDescriptor
+	flowtableIP4EntryDescriptor *descriptor.FlowtableIP4EntryDescriptor
+}
+
+// Init method registers descriptors for all objects the plugin implements
+func (p *FlowtablePlugin) Init() (err error) {
+	if !p.VPP.IsPluginLoaded("flowtable") {
+		p.Log.Warnf("VPP plugin Flowtable was disabled by VPP")
+		return nil
+	}
+
+	// Get compatible VPP calls handler (relevant to VPP version)
+	p.flowtableHandler = vppcalls.CompatibleFlowtableVppHandler(p.VPP, p.IfPlugin.GetInterfaceIndex(), p.Log)
+	if p.flowtableHandler == nil {
+		return errors.New("Flowtable VPP Handler is not available")
+	}
+
+	// init & register flowtable descriptors
+	p.flowtableQinqIfaceDescriptor = descriptor.NewFlowtableQinqIntfDescriptor(p.flowtableHandler, p.Log)
+	flowtableQinqIfaceDescriptor := adapter.NewFlowtableQinqIntfDescriptor(p.flowtableQinqIfaceDescriptor.GetDescriptor())
+	err = p.KVScheduler.RegisterKVDescriptor(flowtableQinqIfaceDescriptor)
+	if err != nil {
+		return err
+	}
+
+	p.flowtableQinqEntryDescriptor = descriptor.NewFlowtableQinqEntryDescriptor(p.flowtableHandler, p.Log)
+	flowtableQinqEntryDescriptor := adapter.NewFlowtableQinqEntryDescriptor(p.flowtableQinqEntryDescriptor.GetDescriptor())
+	err = p.KVScheduler.RegisterKVDescriptor(flowtableQinqEntryDescriptor)
+	if err != nil {
+		return err
+	}
+
+	p.flowtableIP4IfaceDescriptor = descriptor.NewFlowtableIP4IntfDescriptor(p.flowtableHandler, p.Log)
+	flowtableIP4IfaceDescriptor := adapter.NewFlowtableIP4IntfDescriptor(p.flowtableIP4IfaceDescriptor.GetDescriptor())
+	err = p.KVScheduler.RegisterKVDescriptor(flowtableIP4IfaceDescriptor)
+	if err != nil {
+		return err
+	}
+
+	p.flowtableIP4EntryDescriptor = descriptor.NewFlowtableIP4EntryDescriptor(p.flowtableHandler, p.Log)
+	flowtableIP4EntryDescriptor := adapter.NewFlowtableIP4EntryDescriptor(p.flowtableIP4EntryDescriptor.GetDescriptor())
+	err = p.KVScheduler.RegisterKVDescriptor(flowtableIP4EntryDescriptor)
+	if err != nil {
+		return err
+	}
+
+	return nil
+}
+
+// AfterInit registers plugin with StatusCheck.
+func (p *FlowtablePlugin) AfterInit() error {
+	if p.StatusCheck != nil {
+		p.StatusCheck.Register(p.PluginName, nil)
+	}
+	return nil
+}
