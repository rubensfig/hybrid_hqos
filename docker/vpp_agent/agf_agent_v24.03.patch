index 000000000..f0648fb79
--- /dev/null
+++ b/agf-dp-mgmt-plugins/proto/agfencap/agfencap.proto
@@ -0,0 +1,64 @@
+syntax = "proto3";
+
+package ligato.vpp.agfencap;
+
+option go_package = "_/agf-dp-mgmt-plugins/proto/agfencap;vpp_agfencap";
+
+//Enable AGF Encap Qinq node on interface
+message AgfEncapQinqIntf {
+
+    bool enable = 1;        /* agf encap qinq enable or disable */
+    string interface = 2;   /* interface name  */
+
+}
+
+//Enable Agf Encap Gtpu node on interface
+message AgfEncapGtpuIntf {
+
+    bool   enable = 1;          /* agf encap gtpu enable or disable */
+    string interface = 2;       /* interface name  */
+
+}
+
+//Enable AGF Encap Qinq PPPOE node on interface
+message AgfEncapQinqPppoeIntf {
+
+    bool enable = 1;        /* agf encap qinq pppoe enable or disable */
+    string interface = 2;   /* interface name  */
+
+}
+
+
+// Add qinq entry to AGF Encap
+message AgfEncapQinqEntry {
+
+    uint32 s_vlan = 1;          /* S - vlan id */
+    uint32 c_vlan = 2;          /* C - vlan id */
+    string dst_mac = 3;         /* destination MAC address */
+    string src_mac = 4;         /* source MAC address */
+    uint32 flow_id = 5;         /* Flow id */
+
+}
+
+// Add Gtpu entry to AGF Encap
+message AgfEncapGtpuEntry {
+
+    string src_ip = 1;      /* source IP address */
+    string dst_ip = 2;      /* destination IP address */
+    uint32 dscp = 3;        /* dscp */
+    uint32 dst_port = 4;    /* destination port */
+    uint32 flow_id = 5;     /* Flow id */
+    uint32 te_id = 6;       /* TE id */
+
+}
+
+// Add Qinq PPPOE entry
+message AgfEncapQinqPppoeEntry {
+
+    uint32 s_vlan = 1;          /* S - vlan id */
+    uint32 c_vlan = 2;          /* C - vlan id */
+    string dst_mac = 3;         /* destination MAC address */
+    string src_mac = 4;         /* source MAC address */
+    uint32 flow_id = 5;         /* Flow id */
+    uint32 session_id = 6;      /* Session id */
+}
