+
+	kvs "go.ligato.io/vpp-agent/v3/plugins/kvscheduler/api"
+)
+
+const (
+	// FlowtableIP4EntryDescriptorName is the name of the descriptor for vpp flowtable IP4 entry.
+	FlowtableIP4EntryDescriptorName = "vpp-flowtable-ip4entry"
+)
+
+// Validation errors:
+var (
+	// ErrSrcIpNotDefined returned when source IP address in confiugration is empty string.
+	ErrSrcIPNotDefined = errors.New("invalid source IP address for Flowtable IP4 entry")
+
+	// ErrDstIpNotDefined returned when destination IP address in confiugration is empty string.
+	ErrDstIPNotDefined = errors.New("invalid destination IP address for Flowtable IP4 entry")
+)
+
+// FlowtableIP4IntfDescriptor teaches KVScheduler how to configure VPP Flowtable entries.
+type FlowtableIP4EntryDescriptor struct {
+	log                      logging.Logger
+	flowtableIP4EntryHandler vppcalls.FlowtableIP4EntryVppAPI
+}
+
+// NewFlowtableIP4EntryDescriptor creates a new instance of the descriptor.
+func NewFlowtableIP4EntryDescriptor(flowtableIP4EntryHandler vppcalls.FlowtableIP4EntryVppAPI, log logging.PluginLogger) *FlowtableIP4EntryDescriptor {
+
+	return &FlowtableIP4EntryDescriptor{
+		flowtableIP4EntryHandler: flowtableIP4EntryHandler,
+		log:                      log.NewLogger("flowtable-ip4entry-descriptor"),
+	}
+}
+
+// GetDescriptor returns descriptor suitable for registration (via adapter) with the KVScheduler.
+func (f *FlowtableIP4EntryDescriptor) GetDescriptor() *adapter.FlowtableIP4EntryDescriptor {
+	return &adapter.FlowtableIP4EntryDescriptor{
+		Name:            FlowtableIP4EntryDescriptorName,
+		NBKeyPrefix:     flw.ModelFlowtableIP4Entry.KeyPrefix(),
+		ValueTypeName:   flw.ModelFlowtableIP4Entry.ProtoName(),
+		KeySelector:     flw.ModelFlowtableIP4Entry.IsKeyValid,
+		KeyLabel:        flw.ModelFlowtableIP4Entry.StripKeyPrefix,
+		ValueComparator: f.EquivalentFlowtableIP4Entry,
+		Validate:        f.Validate,
+		Create:          f.Create,
+		Delete:          f.Delete,
+	}
+
+}
+
+// EquivalentFlowtableIP4Entry is case-insensitive comparison function for flowtable IP4 Entry.
+func (f *FlowtableIP4EntryDescriptor) EquivalentFlowtableIP4Entry(key string, oldIP4Entry, newIP4Entry *flw.FlowtableIP4Entry) bool {
+	return proto.Equal(oldIP4Entry, newIP4Entry)
+}
+
+// Validate validates value before it is applied.
+func (f *FlowtableIP4EntryDescriptor) Validate(key string, flowtableIP4Entry *flw.FlowtableIP4Entry) error {
+
+	if flowtableIP4Entry.GetIpSrc() == "" {
+		return kvs.NewInvalidValueError(ErrSrcIPNotDefined, "src-ip")
+	}
+	if flowtableIP4Entry.GetIpDst() == "" {
+		return kvs.NewInvalidValueError(ErrDstIPNotDefined, "dst-ip")
+	}
+
+	return nil
+}
+
+// Create uses vppcalls to pass Flowtable IP4 configuration to VPP.
+func (f *FlowtableIP4EntryDescriptor) Create(key string, flowtableIP4Entry *flw.FlowtableIP4Entry) (metadata interface{}, err error) {
+	//Add Flowtable IP4 entry
+	err = f.flowtableIP4EntryHandler.AddFlowtableIP4Entry(flowtableIP4Entry)
+	if err != nil {
+		f.log.Error(err)
+	}
+	return nil, err
+
+}
+
+// Delete removes Flowtable IP4 configuration.
+func (f *FlowtableIP4EntryDescriptor) Delete(key string, flowtableIP4Entry *flw.FlowtableIP4Entry, metadata interface{}) error {
+	//Delete Flowtable IP4 entry
+	err := f.flowtableIP4EntryHandler.DeleteFlowtableIP4Entry(flowtableIP4Entry)
+	if err != nil {
+		f.log.Error(err)
+	}
+	return err
+}
