+			Name: (&vpp_interfaces.SwInterfaceRxPlacementDump{}).GetMessageName(),
+			Ping: true,
+			Messages: []govppapi.Message{
+				&vpp_interfaces.SwInterfaceRxPlacementDetails{
+					SwIfIndex: 0,
+					QueueID:   0,
