+)
+
+// FirewallVppAPI groups Firewall Vpp APIs.
+type FirewallVppAPI interface {
+	BlocklistInterfaceVppAPI
+	BlocklistRuleIpv45TupleVppAPI
+
+	AllowlistInterfaceVppAPI
+	AllowlistRuleIpv45TupleVppAPI
+}
+
+var handler = vpp.RegisterHandler(vpp.HandlerDesc{
+	Name:       "vpp_firewall",
+	HandlerAPI: (*FirewallVppAPI)(nil),
+})
+
+// BlocklistInterfaceVppAPI provides methods for managing Firewall Blocklist enable/disable
+type BlocklistInterfaceVppAPI interface {
+	EnableBlocklistIntf(blocklistinterface *frwl.BlocklistInterface) error
+	DisableBlocklistIntf(blocklistinterface *frwl.BlocklistInterface) error
+}
+
+// BlocklistRuleIpv45TupleVppAPI provides methods for managing Firewall Blocklist IPv4 5Tuple rules
+type BlocklistRuleIpv45TupleVppAPI interface {
+	AddBlocklistRuleIpv45Tuple(blocklistRuleIpv45Tuple *frwl.BlocklistRuleIpv45Tuple) error
+	DeleteBlocklistRuleIpv45Tuple(blocklistRuleIpv45Tuple *frwl.BlocklistRuleIpv45Tuple) error
+}
+
+// AllowlistInterfaceVppAPI provides methods for managing Firewall Allowlist enable/disable
+type AllowlistInterfaceVppAPI interface {
+	EnableAllowlistIntf(allowlistinterface *frwl.AllowlistInterface) error
+	DisableAllowlistIntf(allowlistinterface *frwl.AllowlistInterface) error
+}
+
+// AllowlistRuleIpv45TupleVppAPI provides methods for managing Firewall Allowlist IPv4 5Tuple rules
+type AllowlistRuleIpv45TupleVppAPI interface {
+	AddAllowlistRuleIpv45Tuple(allowlistRuleIpv45Tuple *frwl.AllowlistRuleIpv45Tuple) error
+	DeleteAllowlistRuleIpv45Tuple(allowlistRuleIpv45Tuple *frwl.AllowlistRuleIpv45Tuple) error
+}
+
+// AddFirewallHandlerVersion is used to register implementations of VPP handler API
+// interface for a specific VPP version.
+func AddFirewallHandlerVersion(version vpp.Version, msgs []govppapi.Message,
+	h func(ch govppapi.Channel, ifIdx ifaceidx.IfaceMetadataIndex, log logging.Logger) FirewallVppAPI,
+) {
+	handler.AddVersion(vpp.HandlerVersion{
+		Version: version,
+		Check: func(c vpp.Client) error {
+			ch, err := c.NewAPIChannel()
+			if err != nil {
+				return err
+			}
+			return ch.CheckCompatiblity(msgs...)
+		},
+		NewHandler: func(c vpp.Client, a ...interface{}) vpp.HandlerAPI {
+			ch, err := c.NewAPIChannel()
+			if err != nil {
+				return err
+			}
+			return h(ch, a[0].(ifaceidx.IfaceMetadataIndex), a[1].(logging.Logger))
+		},
+	})
+}
+
+// CompatibleFirewallVppHandler checks all the registered implementations to find the
+// compatible handler implementation.
+func CompatibleFirewallVppHandler(c vpp.Client, ifIdx ifaceidx.IfaceMetadataIndex, log logging.Logger) FirewallVppAPI {
+	if v := handler.FindCompatibleVersion(c); v != nil {
+		return v.NewHandler(c, ifIdx, log).(FirewallVppAPI)
+	}
+	return nil
+}
